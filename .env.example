# ClassLeaf Environment Configuration
# Copy this file to .env.local and fill in your values.

# -----------------------------------------------------------------------------
# Supabase Configuration
# -----------------------------------------------------------------------------
# Public Supabase Project URL (e.g. https://your-project-id.supabase.co)
# Required on client and server.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Public Supabase Anonymous Key
# Safe for browser exposure; protected by Postgres Row Level Security (RLS).
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Service Role Key (SERVER-ONLY)
# NEVER prefix with NEXT_PUBLIC_ or expose to the browser.
# Used for backend administrative operations and background workers.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Note: The connector also accepts SUPABASE_URL, SUPABASE_ANON_KEY, and SUPABASE_SERVICE_KEY
# if configured in your .env.local.

# -----------------------------------------------------------------------------
# Groq LLM Configuration (SERVER-ONLY)
# -----------------------------------------------------------------------------
# Groq API Key for vision OCR extraction, text cleanup, and markdown structuring.
GROQ_API_KEY=gsk_your_groq_api_key

# Groq Vision Model identifier for stage 3 handwriting extraction
GROQ_VISION_MODEL=llama-3.2-11b-vision-preview

# Groq Text Model identifier for stage 4 markdown cleanup & formatting
GROQ_TEXT_MODEL=llama-3.3-70b-versatile

# -----------------------------------------------------------------------------
# App Configuration
# -----------------------------------------------------------------------------
# Canonical base URL for link generation and preview chips (e.g. http://localhost:3000)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
